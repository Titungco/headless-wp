{
  "family": "headless-wp",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/headless-wp-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/headless-wp-task-role",
  "containerDefinitions": [
    {
      "name": "headless-wp",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/headless-wp:latest",
      "essential": true,
      "readonlyRootFilesystem": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "linuxParameters": {
        "tmpfs": [
          { "containerPath": "/tmp", "size": 128 }
        ]
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/wp/graphql -X POST -H 'Content-Type: application/json' -d '{\"query\":\"{ generalSettings { url } }\"}' || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "environment": [
        { "name": "WP_ENV", "value": "production" },
        { "name": "DB_NAME", "value": "wordpress" },
        { "name": "DB_USER", "value": "wordpress" },
        { "name": "DB_HOST", "value": "<RDS_ENDPOINT>" },
        { "name": "WP_HOME", "value": "https://<PUBLIC_DOMAIN>" },
        { "name": "WP_SITEURL", "value": "https://<PUBLIC_DOMAIN>/wp" },
        { "name": "WORDPRESS_SITE_TITLE", "value": "Headless WordPress" },
        { "name": "WORDPRESS_ADMIN_USER", "value": "admin" },
        { "name": "REDIS_HOST", "value": "<ELASTICACHE_ENDPOINT>" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "S3_UPLOADS_BUCKET", "value": "<S3_MEDIA_BUCKET>" },
        { "name": "S3_UPLOADS_REGION", "value": "<REGION>" },
        { "name": "AUTH0_DOMAIN", "value": "<AUTH0_DOMAIN>" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/db-password" },
        { "name": "WORDPRESS_ADMIN_PASSWORD", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/admin-password" },
        { "name": "AUTH_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/auth-key" },
        { "name": "SECURE_AUTH_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/secure-auth-key" },
        { "name": "LOGGED_IN_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/logged-in-key" },
        { "name": "NONCE_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/nonce-key" },
        { "name": "AUTH_SALT", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/auth-salt" },
        { "name": "SECURE_AUTH_SALT", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/secure-auth-salt" },
        { "name": "LOGGED_IN_SALT", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/logged-in-salt" },
        { "name": "NONCE_SALT", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/nonce-salt" },
        { "name": "AUTH0_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/auth0-client-id" },
        { "name": "AUTH0_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<AWS_ACCOUNT_ID>:secret:headless-wp/auth0-client-secret" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/headless-wp",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
