# Copy to .env for local dev (docker-compose reads it directly). In AWS,
# these are injected into the ECS task as plain env vars or Secrets Manager
# entries (see ecs/task-definition.json) — never committed as a real .env.
# Variable names follow the Bedrock convention (config/application.php).

WP_ENV=development

# ---- Database ----
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=mysql
DB_PREFIX=wp_

# ---- Auth keys/salts ----
# Generate real values per environment: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=change-me
SECURE_AUTH_KEY=change-me
LOGGED_IN_KEY=change-me
NONCE_KEY=change-me
AUTH_SALT=change-me
SECURE_AUTH_SALT=change-me
LOGGED_IN_SALT=change-me
NONCE_SALT=change-me

# ---- Site ----
WP_HOME=http://localhost:8080
WP_SITEURL=${WP_HOME}/wp
WORDPRESS_SITE_TITLE=Headless WordPress

# First-boot bootstrap admin (wp-admin login is disabled once Auth0 is wired up;
# this account exists so WordPress has a first user).
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me
WORDPRESS_ADMIN_EMAIL=admin@example.com

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# ---- Media (S3 / MinIO locally) ----
S3_UPLOADS_BUCKET=wp-media
S3_UPLOADS_REGION=us-east-1
S3_UPLOADS_KEY=minioadmin
S3_UPLOADS_SECRET=minioadmin
# Only set locally — omit in production so the ECS task role is used instead.
S3_UPLOADS_ENDPOINT=http://minio:9000

# ---- Auth0 (admin SSO) ----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=change-me
AUTH0_CLIENT_SECRET=change-me
