{
    "name": "titung/headless-wp",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "composer/installers": "^2.0",
        "oscarotero/env": "^2.1",
        "roots/bedrock-autoloader": "^1.0",
        "roots/bedrock-disallow-indexing": "^2.0",
        "roots/wordpress": "7.1",
        "roots/wp-config": "^1.0",
        "vlucas/phpdotenv": "^5.6",
        "wpackagist-plugin/wp-graphql": "^1.28",
        "wpackagist-plugin/wpgraphql-smart-cache": "^1.3",
        "wpackagist-plugin/redis-cache": "^2.5",
        "auth0/wordpress": "^5.6",
        "humanmade/s3-uploads": "^3.0",
        "wpackagist-theme/twentytwentyfive": "^1.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "extra": {
        "wordpress-install-dir": "web/wp",
        "installer-paths": {
            "web/app/mu-plugins/auth0/": ["auth0/wordpress"],
            "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin", "type:wordpress-plugin"],
            "web/app/themes/{$name}/": ["type:wordpress-theme"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        }
    },
    "minimum-stability": "stable"
}
